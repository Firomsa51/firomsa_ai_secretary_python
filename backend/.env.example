# ─────────────────────────────────────────────────────────────────────────────
# Firomsa AI Secretary — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
# Comma-separated allowed origins for CORS (JSON array syntax)
CORS_ORIGINS=["http://localhost:3000"]

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Async PostgreSQL connection string — asyncpg driver is required
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/firomsa

# ── Telegram MTProto ──────────────────────────────────────────────────────────
# Get API_ID and API_HASH from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Your personal Telegram phone number (with country code, e.g. +1234567890)
TELEGRAM_PHONE=

# Telethon StringSession — leave blank on first run.
# After authenticating, export and store the session string here to avoid
# re-authenticating on every restart.
TELEGRAM_SESSION=

# ── AI Providers ──────────────────────────────────────────────────────────────
# Choose "openai" or "groq"
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Groq (only required if AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
